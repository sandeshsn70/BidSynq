# Replace this key before any shared or deployed use.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
# Local development default; Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./bidsynq.db
BIDSYNQ_ALLOW_ADMIN_REGISTRATION=false
# Optional: enables generated answers grounded in retrieved tender passages.
# If empty, the app returns evidence excerpts without calling an LLM.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MAX_DOCUMENT_MB=15

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
