# Copy to .env for LOCAL development only. Never commit .env. Placeholders only.
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
DATABASE_URL=sqlite:///./bidsynq.db
ACCESS_TOKEN_MINUTES=60
BIDSYNQ_ALLOW_ADMIN_REGISTRATION=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=35
MAX_DOCUMENT_MB=15
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DOCUMENT_STORAGE_DIR=storage/tender_documents
